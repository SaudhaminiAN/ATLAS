# ATLAS environment variables — copy to .env and adjust

# Application
APP_NAME=ATLAS
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# Security (required — min 16 characters)
JWT_SECRET=change-me-to-a-secure-32-char-secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Pipeline
PIPELINE_RISK_ENABLED=false
PIPELINE_STAGE_TIMEOUT_SECONDS=5.0
PIPELINE_DEDUPE_WINDOW_SECONDS=60

# Market Data (Spec 02)
MARKET_DATA_MOCK_ENABLED=true
MARKET_DATA_MOCK_TIMEFRAME=M15
MARKET_DATA_MOCK_INTERVAL_SECONDS=2.0
MARKET_DATA_OUTLIER_ATR_MULTIPLIER=5.0
MARKET_DATA_OUTLIER_ATR_LOOKBACK=14
MARKET_DATA_GAP_TOLERANCE_BARS=1

# News Filter (Spec 19)
NEWS_HARD_BLOCK_MINUTES_BEFORE=15
NEWS_HARD_BLOCK_MINUTES_AFTER=15
NEWS_SOFT_DOWNGRADE_MINUTES_BEFORE=30
NEWS_SOFT_DOWNGRADE_MINUTES_AFTER=30
NEWS_SOFT_DOWNGRADE_PENALTY=0.20
NEWS_CALENDAR_SYNC_INTERVAL_MINUTES=15
NEWS_CALENDAR_STALE_WARNING_MINUTES=60
NEWS_MOCK_ENABLED=true

# Market Context (Spec 03)
MARKET_CONTEXT_BIAS_TIMEFRAME=H4
MARKET_CONTEXT_PRIMARY_TIMEFRAME=M15
MARKET_CONTEXT_ATR_PERIOD=14
MARKET_CONTEXT_ATR_PERCENTILE_LOOKBACK=100
MARKET_CONTEXT_MIN_BARS_REQUIRED=100

# MTF Analysis (Spec 04)
MTF_ALIGNMENT_THRESHOLD=0.75
MTF_BIAS_SOURCE=smc_trend
MTF_MIN_BARS=50
MTF_BAR_LOOKBACK=120

# Technical Analysis (Spec 05)
TECHNICAL_SWING_LOOKBACK=2
TECHNICAL_MERGE_TOLERANCE_PCT=0.001
TECHNICAL_MIN_BARS=200
TECHNICAL_BAR_LOOKBACK=250

# SMC (Spec 06)
SMC_SWING_LOOKBACK=2
SMC_DISPLACEMENT_ATR_MULTIPLIER=1.5
SMC_OB_MITIGATION_PCT=0.50
SMC_EQUAL_LEVEL_TOLERANCE_PCT=0.001
SMC_FVG_FILL_PCT=0.50
SMC_MIN_BARS=50
SMC_BAR_LOOKBACK=120

# Price Action (Spec 07)
PRICE_ACTION_LEVEL_PROXIMITY_PCT=0.0015
PRICE_ACTION_MIN_PATTERN_STRENGTH=0.30
PRICE_ACTION_DISPLACEMENT_ATR_MULTIPLIER=1.5
PRICE_ACTION_MIN_BARS=3
PRICE_ACTION_BAR_LOOKBACK=120

# Confluence (Spec 08)
CONFLUENCE_MIN_EVIDENCE_COUNT=3

# External (future specs)
# MARKET_DATA_API_KEY=
# LLM_API_KEY=
