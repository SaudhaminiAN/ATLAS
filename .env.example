# ATLAS environment variables — copy to .env and adjust

# Application
APP_NAME=ATLAS
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=true

# Security (required — min 16 characters)
JWT_SECRET=change-me-to-a-secure-32-char-secret
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://atlas:atlas@localhost:5432/atlas

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# Pipeline
PIPELINE_RISK_ENABLED=false

# External (future specs)
# MARKET_DATA_API_KEY=
# LLM_API_KEY=
